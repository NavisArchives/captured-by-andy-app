{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Captured by Andy",
  "version": "0.1.0",
  "identifier": "com.capturedbyandy.library",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Captured by Andy",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0e0e0f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "helpers/videoframe": "helpers/videoframe",
      "helpers/listen": "helpers/listen",
      "helpers/airdrop": "helpers/airdrop",
      "helpers/vision": "helpers/vision",
      "helpers/clip": "helpers/clip",
      "helpers/review": "helpers/review",
      "helpers/webshot": "helpers/webshot",
      "helpers/bin": "helpers/bin",
      "helpers/places": "helpers/places"
    }
  }
}
